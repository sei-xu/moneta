# Edge Function secrets. Copy to supabase/.env (gitignored), fill in, then:
#
#   supabase secrets set --env-file supabase/.env
#
# NOTE: the worker secret is deliberately NOT here. It lives only in Supabase
# Vault, as the single source both the pg_cron jobs and the Edge Functions
# read (the latter through public.worker_secret()). Keeping a second copy in
# this file is what let the cron job drift out of sync and return 401 on
# every tick, unnoticed. To set or rotate it:
#
#   select vault.create_secret('<value>', 'worker_secret',
#                              'Shared secret for pg_cron -> Edge Function calls');
#
#   select vault.update_secret(
#     (select id from vault.secrets where name = 'worker_secret'), '<new>');

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Analysis worker (optional — defaults shown)
ANALYSIS_PROVIDER=gemini
# ANALYSIS_MODEL=
# ANALYSIS_MAX_FOLLOWUPS=3
# KIMI_API_KEY=            # only when ANALYSIS_PROVIDER=kimi
