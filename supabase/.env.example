# Edge Function secrets. Copy to supabase/.env (gitignored), fill in, then:
#
#   supabase secrets set --env-file supabase/.env
#
# WORKER_SECRET additionally has to reach pg_cron, which cannot read this
# file — Postgres has no access to the Edge Functions' environment. Store the
# same value in Supabase Vault once:
#
#   select vault.create_secret('<same WORKER_SECRET>', 'worker_secret',
#                              'Shared secret for pg_cron -> Edge Function calls');
#
# The scheduled jobs in 20260930000003 decrypt it from there at run time.

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Shared by process-receipts, analyze-expenses, notify-pending-review and the
# bot's /processar and /analisar commands. openssl rand -hex 32
WORKER_SECRET=

# Analysis worker (optional — defaults shown)
ANALYSIS_PROVIDER=gemini
# ANALYSIS_MODEL=
# ANALYSIS_MAX_FOLLOWUPS=3
# KIMI_API_KEY=            # only when ANALYSIS_PROVIDER=kimi
