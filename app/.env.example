# Copy to app/.env.local (gitignored) and fill in.
#
# Both values are public by design — they ship inside the browser bundle.
# What protects the data is RLS: a signed-in user reads nothing unless they
# have a row in app_users. The service_role key must NEVER appear here.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key from Project Settings > API>
